# Application
NODE_ENV=development
PORT=3333
API_PREFIX=/api

# Security
# Comma-separated allowlist of frontend origins (set to * only if you explicitly want open CORS)
CORS_ORIGIN=http://localhost:5173
# Set to false in production when you do not want to expose docs publicly
ENABLE_SWAGGER=true
# Optional Swagger basic auth (if both are set, /api-docs requires login)
SWAGGER_USER=
SWAGGER_PASSWORD=
# JSON body max payload size (Express format)
JSON_BODY_LIMIT=100kb
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Seed control: set to "true" ONLY in local/dev environments
# to populate the database with fake data. NEVER enable in production.
RUN_SEED=false

# Database
DATABASE_URL=postgresql://docpratico:docpratico@localhost:5432/docpratico?schema=public
